# Records assets/demo.gif with https://github.com/charmbracelet/vhs: cargo build --release && vhs assets/demo.tape
Output assets/demo.gif
Set Shell "bash"
Set FontSize 22
Set Width 960
Set Height 190
Set Padding 24
Set TypingSpeed 70ms
Set Theme "Catppuccin Mocha"
Env PS1 "$ "
Hide
Type "export PATH=$PWD/target/release:$PATH && clear"
Enter
Sleep 500ms
Show
Sleep 500ms
Type "fue defunkt"
Sleep 400ms
Enter
Sleep 4s
